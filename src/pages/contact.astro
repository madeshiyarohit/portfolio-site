---
import Base from "../layouts/Base.astro";
import { SITE, liveSocials } from "../site.config.mjs";

const ld = [
  { "@context": "https://schema.org", "@type": "ContactPage", name: `Contact ${SITE.name}`, url: new URL("/contact/", SITE.url).href,
    about: { "@type": "Person", name: SITE.name, email: SITE.email, url: SITE.url + "/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Contact", item: new URL("/contact/", SITE.url).href } ] }
];
const services = ["Shopify Store Design", "Shopify Speed & Fixes", "Full Shopify Store Build", "Shopify Consulting", "Store Testing / QA", "Something else"];
const budgets = ["Under $200", "$200 – $600", "$600 – $1,500", "$1,500+", "Not sure yet"];
---
<Base page="contact" title={`Contact ${SITE.name} | Hire a Shopify Expert`}
  description="Tell Rohit Madeshiya about your Shopify store. Send a message or book a free meeting, and get a reply about your project."
  jsonLd={ld}>
  <header class="page-head">
    <div class="wrap">
      <ol class="crumbs reveal"><li><a href="/">Home</a></li><li aria-current="page">Contact</li></ol>
      <h1 class="reveal">Let's build something <span class="serif hl">great.</span></h1>
      <p class="lead reveal">Tell me a little about your store and what you need. I read every message myself.</p>
    </div>
  </header>
  <section class="sec" style="padding-top:0">
    <div class="wrap contact-grid">
      <aside class="contact-side reveal">
        <a class="c-card" href={SITE.bookingUrl} target="_blank" rel="noopener">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
          <span><small>Prefer to talk?</small><b>Book a free meeting</b></span>
        </a>
        <button class="c-card" type="button" data-copy-email>
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><small>Email me directly (click to copy)</small><b>{SITE.email}</b></span>
        </button>
        <div class="c-card">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <span><small>100% remote</small><b>Available for projects worldwide</b></span>
        </div>
        <div class="c-card">
          <span class="ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/></svg></span>
          <span><small>Fast replies</small><b>I reply within 24 hours</b></span>
        </div>
        {SITE.whatsapp && <a class="c-card" href={`https://wa.me/${SITE.whatsapp.replace(/[^0-9]/g, "")}?text=${encodeURIComponent("Hi Rohit, I found your website and I'd like to talk about my Shopify store.")}`} target="_blank" rel="noopener">
          <span class="ci"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2zm5.8 14.1c-.25.7-1.44 1.33-2 1.41-.51.08-1.16.11-1.87-.12a17 17 0 0 1-1.7-.63c-2.98-1.29-4.93-4.29-5.08-4.49-.14-.19-1.21-1.61-1.21-3.07s.77-2.18 1.04-2.48c.27-.3.59-.37.79-.37h.57c.18.01.43-.07.67.51.25.6.84 2.06.92 2.21.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.32.39-.45.52-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.47.13.64-.07.17-.19.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.12.08.71-.17 1.41z"/></svg></span>
          <span><small>Prefer chatting?</small><b>Message me on WhatsApp</b></span>
        </a>}
        {liveSocials.length > 0 && <div class="chips" style="margin-top:6px">
          {liveSocials.map(s => <a href={s.url} target="_blank" rel="noopener me">{s.label}</a>)}
        </div>}
      </aside>

      <div class="form-wrap reveal">
      <form class="form" id="contact-form" novalidate data-key={SITE.web3formsKey}>
        <div class="form-head">
          <h2>Tell me about your project</h2>
          <p>A few details are enough. Fields marked <i>*</i> are required.</p>
        </div>
        <div class="row">
          <div class="field"><label for="f-name">Your name <i>*</i></label><div class="control"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><input id="f-name" name="name" type="text" autocomplete="name" required minlength="5" maxlength="100" placeholder="Your full name" aria-describedby="e-name"></div><span class="err" id="e-name" hidden></span></div>
          <div class="field"><label for="f-email">Email <i>*</i></label><div class="control"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><input id="f-email" name="email" type="email" inputmode="email" autocomplete="email" required maxlength="100" placeholder="you@yourstore.com" aria-describedby="e-email"></div><span class="err" id="e-email" hidden></span></div>
        </div>
        <fieldset class="field">
          <legend>What do you need?</legend>
          <div class="choices">{services.map(s => <label class="choice"><input type="radio" name="service" value={s}><span>{s}</span></label>)}</div>
        </fieldset>
        <fieldset class="field">
          <legend>Budget</legend>
          <div class="choices">{budgets.map(b => <label class="choice"><input type="radio" name="budget" value={b}><span>{b}</span></label>)}</div>
        </fieldset>
        <div class="field"><label for="f-store">Store or website link <span class="opt">optional</span></label><div class="control"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg><input id="f-store" name="store" type="url" placeholder="https://yourstore.com" maxlength="300" aria-describedby="e-store"></div><span class="err" id="e-store" hidden></span><span class="hint">It helps me give better advice before we talk.</span></div>
        <div class="field"><label for="f-message">Your message <i>*</i></label><textarea id="f-message" name="message" required maxlength="5000" placeholder="Tell me about your store, your goals and your timeline." aria-describedby="e-message"></textarea><span class="err" id="e-message" hidden></span><span class="hint count" id="f-count" aria-live="polite">0 / 5000</span></div>
        <!-- Spam trap: people never see or fill this field, bots do. -->
        <label class="hp" aria-hidden="true">Leave this empty<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off"></label>
        <div class="form-status" id="form-status" role="status" hidden></div>
        <div class="form-foot">
          <button class="btn btn-accent" type="submit">Send Message <span class="arr" aria-hidden="true">→</span></button>
          <p class="form-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>Your details are only used to reply to you. No spam, ever.</p>
        </div>
      </form>
      <div class="form-done" id="form-done" hidden tabindex="-1">
        <span class="done-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span>
        <h2>Message sent!</h2>
        <p>Thank you for reaching out. I'll read your message and reply to you by email soon.</p>
        <div class="contact-actions"><a class="btn btn-accent" href={SITE.bookingUrl} target="_blank" rel="noopener">Book a Free Meeting <span class="arr" aria-hidden="true">→</span></a><button class="btn btn-ghost" type="button" id="form-again">Send another message</button></div>
      </div>
      </div>
    </div>
  </section>

  <script is:inline slot="after">
    /* Contact form: checks every field in the browser first, then sends the message to Rohit's email through Web3Forms. */
    const form = document.getElementById("contact-form"), status = document.getElementById("form-status");
    const done = document.getElementById("form-done"), counter = document.getElementById("f-count");
    const F = { name: document.getElementById("f-name"), email: document.getElementById("f-email"), store: document.getElementById("f-store"), message: document.getElementById("f-message") };
    const LIMITS = { nameMin: 5, nameMax: 100, emailMax: 100 };

    // Throwaway / temporary inbox services (10-minute mail and similar) are not accepted.
    const DISPOSABLE = new Set(("mailinator.com 10minutemail.com 10minutemail.net 10minemail.com temp-mail.org temp-mail.io tempmail.com tempmail.net tempmailo.com tempail.com " +
      "guerrillamail.com guerrillamail.net guerrillamail.org guerrillamailblock.com sharklasers.com grr.la yopmail.com yopmail.net yopmail.fr trashmail.com trash-mail.com " +
      "getnada.com nada.email dispostable.com maildrop.cc mailnesia.com throwawaymail.com fakeinbox.com mintemail.com moakt.com emailondeck.com mohmal.com burnermail.io " +
      "spamgourmet.com mailcatch.com mytemp.email tempr.email discard.email mail.tm emailfake.com fakemail.net minuteinbox.com 1secmail.com 1secmail.net 1secmail.org " +
      "harakirimail.com getairmail.com inboxkitten.com mailpoof.com spambox.us wegwerfmail.de jetable.org tempinbox.com temporary-mail.net mailtemp.net emailtemporanea.net " +
      "dropmail.me 20minutemail.it 33mailbox.com tmpmail.org tmpmail.net tmails.net mailforspam.com spam4.me").split(" "));
    // Common typos of popular email providers, so we can suggest the right one.
    const TYPOS = { "gmial.com": "gmail.com", "gmai.com": "gmail.com", "gmal.com": "gmail.com", "gamil.com": "gmail.com", "gnail.com": "gmail.com", "gmaill.com": "gmail.com", "gmail.co": "gmail.com", "gmail.con": "gmail.com", "gmail.cm": "gmail.com", "gmail.om": "gmail.com", "gmail.in": "gmail.com",
      "hotmial.com": "hotmail.com", "hotmal.com": "hotmail.com", "hotmail.co": "hotmail.com", "hotmail.con": "hotmail.com", "yaho.com": "yahoo.com", "yahooo.com": "yahoo.com", "yahoo.con": "yahoo.com", "yahho.com": "yahoo.com",
      "outlok.com": "outlook.com", "outllok.com": "outlook.com", "outlook.co": "outlook.com", "outlook.con": "outlook.com", "iclod.com": "icloud.com", "icloud.co": "icloud.com", "icoud.com": "icloud.com" };

    const NAME_RE = /^[\p{L}\p{M}][\p{L}\p{M} '.\-]*$/u;   // letters in any language, spaces, ' . -
    const EMAIL_RE = /^[A-Za-z0-9](?:[A-Za-z0-9._%+-]*[A-Za-z0-9_%+-])?@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\.)+[A-Za-z]{2,24}$/;

    function setError(field, message, html) {
      const el = document.getElementById("e-" + field), input = F[field];
      if (!message) { el.hidden = true; el.textContent = ""; input.removeAttribute("aria-invalid"); return true; }
      el.hidden = false; html ? (el.innerHTML = message) : (el.textContent = message);
      input.setAttribute("aria-invalid", "true");
      return false;
    }
    const tidy = v => v.trim().replace(/\s+/g, " ");

    function checkName() {
      const v = tidy(F.name.value);
      if (!v) return setError("name", "Please enter your name.");
      if (v.length < LIMITS.nameMin) return setError("name", `Name should be at least ${LIMITS.nameMin} characters.`);
      if (v.length > LIMITS.nameMax) return setError("name", `Name can be at most ${LIMITS.nameMax} characters.`);
      if (!NAME_RE.test(v)) return setError("name", "Please use letters only (spaces, apostrophes, dots and hyphens are fine).");
      return setError("name");
    }
    function checkEmailFormat() {
      const v = F.email.value.trim();
      if (!v) return setError("email", "Please enter your email address.");
      if (v.length > LIMITS.emailMax) return setError("email", `Email can be at most ${LIMITS.emailMax} characters.`);
      if (!EMAIL_RE.test(v) || /\.\./.test(v)) return setError("email", "Please enter a valid email address, like name@example.com.");
      const [local, domain] = v.toLowerCase().split("@");
      if (TYPOS[domain]) {
        const fix = `${local}@${TYPOS[domain]}`;
        return setError("email", `Did you mean <button type="button" class="err-fix" data-fix="${fix}">${fix}</button>?`, true);
      }
      if (DISPOSABLE.has(domain) || [...DISPOSABLE].some(d => domain.endsWith("." + d))) return setError("email", "Temporary or disposable email addresses aren't accepted. Please use your regular email.");
      return setError("email");
    }
    // Does the domain really exist and accept email? Asked live via Google's public DNS.
    // If the lookup itself fails (offline, blocked), the visitor is not stopped.
    const domainCache = {};
    async function domainAcceptsMail(domain) {
      if (domain in domainCache) return domainCache[domain];
      const ask = async type => {
        const ctrl = new AbortController(); const t = setTimeout(() => ctrl.abort(), 4000);
        try { const r = await fetch(`https://dns.google/resolve?name=${encodeURIComponent(domain)}&type=${type}`, { signal: ctrl.signal }); return await r.json(); }
        finally { clearTimeout(t); }
      };
      let ok = true;
      try {
        const mx = await ask("MX");
        if (mx.Status === 3) ok = false;                                   // domain doesn't exist
        else if (mx.Answer && mx.Answer.some(a => a.type === 15)) ok = !mx.Answer.every(a => a.type === 15 && /^0 \.?$/.test(a.data)); // "null MX" = no email
        else { const a = await ask("A"); ok = !!(a.Answer && a.Answer.length); } // no MX: mail can still go to the main address
      } catch (e) { ok = true; }
      return (domainCache[domain] = ok);
    }
    function checkStore() {
      const v = F.store.value.trim();
      if (v && !F.store.checkValidity()) return setError("store", "Please enter a full link starting with https://, or leave it empty.");
      return setError("store");
    }
    function checkMessage() {
      return F.message.value.trim() ? setError("message") : setError("message", "Please write a short message.");
    }
    const CHECKS = { name: checkName, email: checkEmailFormat, store: checkStore, message: checkMessage };

    // Check a field when the visitor leaves it, and re-check as they type once an error is showing.
    Object.entries(F).forEach(([key, input]) => {
      input.addEventListener("blur", () => { if (input.value.trim() || input.dataset.touched) { input.dataset.touched = "1"; CHECKS[key](); } });
      input.addEventListener("input", () => { if (input.getAttribute("aria-invalid")) CHECKS[key](); });
    });
    document.getElementById("e-email").addEventListener("click", e => {
      const b = e.target.closest(".err-fix"); if (!b) return;
      F.email.value = b.dataset.fix; checkEmailFormat(); F.email.focus();
    });
    const count = () => { counter.textContent = `${F.message.value.length} / 5000`; };
    F.message.addEventListener("input", count);
    document.getElementById("form-again").addEventListener("click", () => { done.hidden = true; form.hidden = false; F.name.focus(); });
    const show = (msg, ok) => { status.hidden = false; status.className = "form-status " + (ok ? "ok" : "err"); status.textContent = msg; };

    form.addEventListener("submit", async e => {
      e.preventDefault();
      status.hidden = true;
      const results = Object.entries(CHECKS).map(([key, fn]) => [key, fn()]);
      const firstBad = results.find(([, ok]) => !ok);
      if (firstBad) { F[firstBad[0]].focus(); show("Please fix the highlighted fields and try again.", false); return; }
      const btn = form.querySelector("button[type=submit]");
      btn.disabled = true; btn.classList.add("busy");
      // Real domain check before sending
      const domain = F.email.value.trim().toLowerCase().split("@")[1];
      show("Checking your email address…", true);
      if (!(await domainAcceptsMail(domain))) {
        btn.disabled = false; btn.classList.remove("busy"); status.hidden = true;
        setError("email", `The domain "${domain}" doesn't seem to exist or can't receive email. Please check the address.`);
        F.email.focus(); return;
      }
      F.name.value = tidy(F.name.value);
      const data = Object.fromEntries(new FormData(form));
      if (data.botcheck) { btn.disabled = false; btn.classList.remove("busy"); return; }
      const key = form.dataset.key;
      if (!key) {
        // Form service not set up yet: open the visitor's email app with the message filled in instead.
        const body = `Name: ${data.name}\nEmail: ${data.email}\nService: ${data.service || "-"}\nBudget: ${data.budget || "-"}\nStore: ${data.store || "-"}\n\n${data.message}`;
        location.href = `mailto:${document.body.dataset.email}?subject=${encodeURIComponent("Project enquiry from " + data.name)}&body=${encodeURIComponent(body)}`;
        btn.disabled = false; btn.classList.remove("busy"); status.hidden = true;
        return;
      }
      show("Sending…", true);
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ access_key: key, subject: `New portfolio enquiry from ${data.name}`, from_name: "Portfolio contact form", replyto: data.email, ...data })
        });
        const out = await res.json();
        if (!out.success) throw new Error(out.message);
        form.reset(); status.hidden = true; count();
        Object.values(F).forEach(i => { delete i.dataset.touched; });
        form.hidden = true; done.hidden = false; done.focus();
      } catch (err) {
        show("Sorry, the message couldn't be sent. Please email me directly at " + document.body.dataset.email + ".", false);
      } finally { btn.disabled = false; btn.classList.remove("busy"); }
    });
  </script>
</Base>
