---
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { render } from "astro:content";
import { SITE } from "../../site.config.mjs";
import { getPosts, readingTime, formatDate } from "../../lib/content.js";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts } }));
}
const { post, newer, older, all } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const url = new URL(`/blog/${post.id}/`, SITE.url).href;
// Related: posts sharing a tag first, then the newest ones.
const related = all.filter(p => p.id !== post.id)
  .sort((a, b) => b.data.tags.filter(t => d.tags.includes(t)).length - a.data.tags.filter(t => d.tags.includes(t)).length)
  .slice(0, 3);
const ld = [
  { "@context": "https://schema.org", "@type": "BlogPosting", headline: d.title, description: d.description, url, mainEntityOfPage: url,
    image: new URL(d.cover || SITE.shareImage, SITE.url).href, datePublished: d.date.toISOString(), dateModified: (d.updated || d.date).toISOString(),
    keywords: d.tags.join(", "), wordCount: (post.body || "").split(/\s+/).length,
    author: { "@type": "Person", name: SITE.name, url: SITE.url + "/" }, publisher: { "@type": "Person", name: SITE.name, url: SITE.url + "/" } },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: SITE.url + "/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", SITE.url).href },
    { "@type": "ListItem", position: 3, name: d.title, item: url } ] }
];
const shareText = encodeURIComponent(d.title);
const shareUrl = encodeURIComponent(url);
---
<Base page="post" type="article" title={`${d.title} | ${SITE.name}`} description={d.description}
  image={d.cover || SITE.shareImage} imageAlt={d.coverAlt || d.title} published={d.date} modified={d.updated} jsonLd={ld} noindex={d.draft}>
  <article>
    <header class="page-head">
      <div class="wrap">
        <ol class="crumbs reveal"><li><a href="/">Home</a></li><li><a href="/blog/">Blog</a></li><li aria-current="page">Article</li></ol>
        <h1 class="reveal" style="font-size:clamp(36px,5.6vw,68px);max-width:20ch">{d.title}</h1>
        <p class="lead reveal">{d.description}</p>
        <div class="post-meta reveal">
          <span>By {SITE.name}</span><i class="dot" aria-hidden="true"></i>
          <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time><i class="dot" aria-hidden="true"></i>
          <span>{readingTime(post.body)} min read</span>
          {d.updated && <><i class="dot" aria-hidden="true"></i><span>Updated {formatDate(d.updated)}</span></>}
        </div>
        {d.tags.length > 0 && <div class="chips reveal" style="margin-top:16px">{d.tags.map(t => <span>{t}</span>)}</div>}
      </div>
    </header>
    <div class="wrap">
      {d.cover && <figure class="post-cover reveal"><img src={d.cover} alt={d.coverAlt || d.title} width="1600" height="800" fetchpriority="high"></figure>}
      <div class="post-wrap">
        <div>
          <div class="prose"><Content /></div>
          <div class="share">
            <span>Share this article</span>
            <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5 5.2-1.4A9.9 9.9 0 1 0 12.04 2zm5.8 14.1c-.25.7-1.44 1.33-2 1.41-.51.08-1.16.11-1.87-.12a17 17 0 0 1-1.7-.63c-2.98-1.29-4.93-4.29-5.08-4.49-.14-.19-1.21-1.61-1.21-3.07s.77-2.18 1.04-2.48c.27-.3.59-.37.79-.37h.57c.18.01.43-.07.67.51.25.6.84 2.06.92 2.21.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.32.39-.45.52-.15.15-.3.31-.13.61.17.3.77 1.27 1.65 2.06 1.13 1.01 2.09 1.32 2.39 1.47.3.15.47.13.64-.07.17-.19.74-.86.94-1.16.2-.3.4-.25.67-.15.27.1 1.73.82 2.03.97.3.15.5.22.57.35.08.12.08.71-.17 1.41z"/></svg></a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg></a>
            <a href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Share on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.65l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg></a>
            <button type="button" id="copy-link" aria-label="Copy link to this article" data-url={url}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg></button>
          </div>
          <div class="author">
            <img src="/Assets/rohit-madeshiya-shopify-expert-hero.jpg" alt={SITE.name} width="72" height="72" loading="lazy">
            <div><b>Written by {SITE.name}</b><p>Shopify consultant, developer and tester. I build Shopify stores that look great, load fast and are tested before a single customer sees them.</p></div>
          </div>
          <nav class="pager" aria-label="More articles">
            {older && <a href={`/blog/${older.id}/`}><small>← Previous</small><b>{older.data.title}</b></a>}
            {newer && <a class="next" href={`/blog/${newer.id}/`}><small>Next →</small><b>{newer.data.title}</b></a>}
          </nav>
        </div>
        {toc.length >= 3 && <nav class="toc" aria-label="On this page"><b>On this page</b>{toc.map(h => <a href={`#${h.slug}`} class={`l${h.depth}`}>{h.text}</a>)}</nav>}
      </div>
      <div class="cta-band reveal">
        <h2>Want a store that <span class="serif">sells more?</span></h2>
        <p>Let's talk about your Shopify store. The first meeting is free, with no obligation.</p>
        <a class="btn btn-accent" href={SITE.bookingUrl} target="_blank" rel="noopener">Book a Free Meeting <span class="arr" aria-hidden="true">→</span></a>
      </div>
    </div>
  </article>
  {related.length > 0 && <section class="sec">
    <div class="wrap">
      <div class="sec-head"><span class="eyebrow"><b>✦</b>Keep reading</span><h2>More <span class="serif">articles</span></h2></div>
      <div class="card-grid">{related.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>}
  <script is:inline slot="after">
    /* Copy link + highlight the current heading in "On this page" */
    const cl = document.getElementById("copy-link");
    cl && cl.addEventListener("click", () => { navigator.clipboard.writeText(cl.dataset.url).then(() => toast("Link copied"), () => toast(cl.dataset.url)); });
    const tocLinks = [...document.querySelectorAll(".toc a")];
    if (tocLinks.length && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) tocLinks.forEach(a => a.classList.toggle("on", a.getAttribute("href") === "#" + e.target.id)); }), { rootMargin: "-20% 0px -70% 0px" });
      tocLinks.forEach(a => { const h = document.getElementById(a.getAttribute("href").slice(1)); h && io.observe(h); });
    }
  </script>
</Base>
