---
import Base from "../layouts/Base.astro";
import { SITE } from "../site.config.mjs";
---
<Base page="404" title={`Page not found | ${SITE.name}`} description="This page doesn't exist. Head back to the homepage." noindex>
  <section class="sec nf">
    <div class="wrap" style="display:grid;gap:18px;justify-items:center">
      <div class="big404" aria-hidden="true">404</div>
      <h1 style="font-size:clamp(28px,4vw,44px);letter-spacing:-.04em">This page took a <span class="serif hl">coffee break.</span></h1>
      <p style="color:var(--muted);max-width:44ch">The link may be old or mistyped. Everything else is just a click away.</p>
      <div class="contact-actions"><a class="btn btn-accent" href="/">Back to homepage</a><a class="btn btn-ghost" href="/contact/">Contact me</a></div>
    </div>
  </section>
</Base>
