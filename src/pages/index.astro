, "name": "Full Shopify Store Build", "description": "Everything from setup to launch, done for you.", "provider": {"@id": "https://yourdomain.com/#person"}}}]}}, {"@type": "WebSite", "@id": "https://yourdomain.com/#website", "url": "https://yourdomain.com/", "name": "Rohit Madeshiya – Shopify Expert", "publisher": {"@id": "https://yourdomain.com/#person"}, "inLanguage": "en"}, {"@type": "WebPage", "@id": "https://yourdomain.com/#webpage", "url": "https://yourdomain.com/", "name": "Shopify Expert & Developer for Hire | Rohit Madeshiya", "isPartOf": {"@id": "https://yourdomain.com/#website"}, "about": {"@id": "https://yourdomain.com/#person"}, "primaryImageOfPage": {"@type": "ImageObject", "url": "https://yourdomain.com/Assets/rohit-madeshiya-shopify-expert-share.jpg", "width": 1200, "height": 630}, "inLanguage": "en"}, {"@type": "FAQPage", "@id": "https://yourdomain.com/#faq", "mainEntity": [{"@type": "Question", "name": "Do you work with clients outside India?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. I work remotely with brands worldwide. We meet over Google Meet, and you get regular updates so you always know where your store stands."}}, {"@type": "Question", "name": "Can you fix or improve my existing Shopify store?", "acceptedAnswer": {"@type": "Answer", "text": "Absolutely. The Speed & Fixes package covers a speed audit, bug, layout and checkout fixes, all tested across devices before I hand it back."}}, {"@type": "Question", "name": "What makes you different from other Shopify developers?", "acceptedAnswer": {"@type": "Answer", "text": "I'm a developer and a software tester. I tested banking and healthcare apps at Deloitte, so every store I build is checked on every device and browser before a single customer sees it."}}, {"@type": "Question", "name": "How do payments work?", "acceptedAnswer": {"@type": "Answer", "text": "You can pay through Fiverr, PayPal, Payoneer, Wise or a bank transfer, whichever suits you best."}}, {"@type": "Question", "name": "Do you offer support after launch?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Launch day isn't goodbye: I stick around to fix, fine-tune and help your store grow."}}, {"@type": "Question", "name": "How do we get started?", "acceptedAnswer": {"@type": "Answer", "text": "Book a free meeting. We'll talk about your brand, your goals and what your store needs, and I'll suggest the right plan, with no obligation."}}]}]}).replaceAll("https://yourdomain.com", SITE.url));
---
<Base
  page="home"
  title="Shopify Expert & Developer for Hire | Rohit Madeshiya"
  description="Rohit Madeshiya is a Shopify expert, developer and consultant who builds fast, conversion-focused Shopify stores, tested before launch. Book a free meeting."
  jsonLd={graph}
>
  <header class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="status reveal"><i class="live" aria-hidden="true"></i>Available for new projects<i class="sep" aria-hidden="true"></i><time id="local-time"></time></p>
        <p class="hello reveal" id="hello" style="--rd:.05s">👋 Hello there, I'm</p>
        <h1 id="name" class="reveal" style="--rd:.1s">Rohit <span class="last">Madeshiya<span class="hl">.</span></span><span class="sr-only">, Shopify Expert, Developer &amp; Consultant</span></h1>
        <p class="role-line reveal" style="--rd:.15s" aria-live="polite"><span class="ri" id="role-ico" aria-hidden="true"></span><span class="rot serif" id="roles"><span class="on">Shopify Consultant</span><span>Shopify Expert</span><span>Quality Expert</span></span><!--/static--></p>
        <p class="tagline reveal" id="tagline" style="--rd:.2s">I build Shopify stores that <b>stop the scroll</b> and <b>start the sale</b>.</p>
        <div class="hero-cta reveal" style="--rd:.25s">
          <a class="btn btn-accent" id="cta" target="_blank" rel="noopener">
            <svg class="meet-ico" viewBox="0 0 87.5 72" aria-hidden="true">
              <path fill="#00832d" d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"/>
              <path fill="#0066da" d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"/>
              <path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"/>
              <path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"/>
              <path fill="#00ac47" d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"/>
              <path fill="#ffba00" d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"/>
            </svg>
            Book a Free Meeting
          </a>
          <a class="btn btn-ghost" href="#services">See Services <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <ul class="trust reveal" style="--rd:.3s; list-style:none; padding:0" aria-label="Why work with me">
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Free first meeting</span></li>
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Clients worldwide</span></li>
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Tested before launch</span></li>
        </ul>
        <a class="scroll-cue" href="#experience"><i aria-hidden="true"></i>Scroll to explore</a>
      </div>

      <figure class="portrait reveal" style="--rd:.2s; margin:0">
        <span class="ring" aria-hidden="true"></span>
        <div class="portrait-frame">
          <img src="/Assets/rohit-madeshiya-shopify-expert-hero.jpg" alt="Rohit Madeshiya, Shopify expert and developer, smiling with arms crossed" width="900" height="1125" fetchpriority="high">
        </div>
        <div class="float f1" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span><span>Shopify Expert<small>Stores that sell</small></span></div>
        <div class="float f2" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>QA Passed<small>Every device</small></span></div>
        <div class="float f3" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span><span>Fast &amp; tested<small>Speed optimized</small></span></div>
      </figure>
    </div>
  </header>

