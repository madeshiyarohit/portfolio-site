---
// Homepage. ALL text here comes from src/data/profile.js; edit that file, not this one.
// Everything is rendered into plain HTML at build time (fast, and search engines see it all);
// /js/home.js only adds the interactive behaviour.
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { SITE } from "../site.config.mjs";
import { getPosts, getProjects } from "../lib/content.js";
import { PROFILE as P } from "../data/profile.js";
import { ROLE_ICONS, EDU_ICONS, SVC_ICONS, PAY_ICONS, CHECK, CHEV, TICK } from "../data/icons.js";

const projects = await getProjects();
const posts = await getPosts();
const pad = n => String(n).padStart(2, "0");
const prices = P.services.map(s => Number(s.price.replace(/[^0-9.]/g, "")));
// Structured data for Google: who you are, services with prices and the FAQ, all taken from profile.js.
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://yourdomain.com/#person",
      "name": "Rohit Madeshiya",
      "url": "https://yourdomain.com/",
      "image": "https://yourdomain.com/Assets/rohit-madeshiya-shopify-expert-hero.webp",
      "jobTitle": "Shopify Expert, Developer & Consultant",
      "description": "Shopify consultant, developer and tester who builds fast, conversion-focused Shopify stores for brands worldwide, and tests every store before launch.",
      "email": "mailto:itsrohitmadeshiya@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Yamunanagar",
        "addressRegion": "Haryana",
        "addressCountry": "IN"
      },
      "alumniOf": [
        {
          "@type": "CollegeOrUniversity",
          "name": "Tilak Raj Chadha Institute of Management and Technology"
        },
        {
          "@type": "CollegeOrUniversity",
          "name": "Kurukshetra University"
        }
      ],
      "hasOccupation": [
        {
          "@type": "Occupation",
          "name": "Shopify Consultant, Developer & Tester",
          "occupationLocation": {
            "@type": "Country",
            "name": "India"
          },
          "skills": "Shopify, Liquid, theme development, store setup, speed optimization, conversion optimization, QA testing"
        },
        {
          "@type": "Occupation",
          "name": "Software Tester",
          "skills": "Functional, regression and end-to-end testing for banking and healthcare applications"
        }
      ],
      "award": [
        "4 Applause Awards at Deloitte",
        "2 Support Awards at Deloitte"
      ],
      "knowsLanguage": [
        {
          "@type": "Language",
          "name": "English"
        },
        {
          "@type": "Language",
          "name": "Hindi"
        }
      ],
      "knowsAbout": [
        "Shopify",
        "Shopify theme development",
        "Liquid",
        "Shopify store setup",
        "Shopify speed optimization",
        "Conversion rate optimization",
        "Technical SEO",
        "Software testing",
        "Quality assurance",
        "Cross-browser testing",
        "HTML",
        "CSS",
        "JavaScript",
        "React",
        "Bootstrap"
      ]
    },
    {
      "@type": "ProfessionalService",
      "@id": "https://yourdomain.com/#service",
      "name": "Rohit Madeshiya – Shopify Expert & Developer",
      "url": "https://yourdomain.com/",
      "image": "https://yourdomain.com/Assets/rohit-madeshiya-shopify-expert-share.jpg",
      "logo": "https://yourdomain.com/Assets/rohit-madeshiya-favicon-512.png",
      "description": "Shopify store design, development, speed optimization and QA testing for brands worldwide.",
      "founder": {
        "@id": "https://yourdomain.com/#person"
      },
      "email": "itsrohitmadeshiya@gmail.com",
      "priceRange": "$129 – $600",
      "areaServed": "Worldwide",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Yamunanagar",
        "addressRegion": "Haryana",
        "addressCountry": "IN"
      },
      "paymentAccepted": "PayPal, Payoneer, Wise, Bank Transfer, Fiverr",
      "serviceType": [
        "Shopify consulting",
        "Shopify store setup",
        "Shopify theme customization",
        "Shopify speed optimization",
        "Shopify conversion optimization",
        "Shopify QA testing"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Shopify services",
        "itemListElement": P.services.map(s => ({
          "@type": "Offer", name: s.title, description: s.text, url: "https://yourdomain.com/#services",
          priceSpecification: { "@type": "PriceSpecification", minPrice: Number(s.price.replace(/[^0-9.]/g, "")), priceCurrency: "USD" },
          itemOffered: { "@type": "Service", name: s.title, description: s.text, provider: { "@id": "https://yourdomain.com/#person" } }
        }))
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://yourdomain.com/#website",
      "url": "https://yourdomain.com/",
      "name": "Rohit Madeshiya – Shopify Expert",
      "publisher": {
        "@id": "https://yourdomain.com/#person"
      },
      "inLanguage": "en"
    },
    {
      "@type": "WebPage",
      "@id": "https://yourdomain.com/#webpage",
      "url": "https://yourdomain.com/",
      "name": "Shopify Expert & Developer for Hire | Rohit Madeshiya",
      "isPartOf": {
        "@id": "https://yourdomain.com/#website"
      },
      "about": {
        "@id": "https://yourdomain.com/#person"
      },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": "https://yourdomain.com/Assets/rohit-madeshiya-shopify-expert-share.jpg",
        "width": 1200,
        "height": 630
      },
      "inLanguage": "en"
    },
    {
      "@type": "FAQPage",
      "@id": "https://yourdomain.com/#faq",
      "mainEntity": P.faq.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
    }
  ]
};
ld["@graph"].find(x => x["@type"] === "ProfessionalService").priceRange = `$${Math.min(...prices)} – $${Math.max(...prices)}`;
const graph = JSON.parse(JSON.stringify(ld).replaceAll("https://yourdomain.com", SITE.url));
const shortTool = n => n.split(" ").map(w => w[0]).join("").slice(0, 2);
const ICON_CLOCK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
const ICON_LOOP = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"/><path d="M3 21v-5h5"/></svg>';
---
<Base
  page="home"
  title="Shopify Expert & Developer for Hire | Rohit Madeshiya"
  description="Rohit Madeshiya is a Shopify expert, developer and consultant who builds fast, conversion-focused Shopify stores, tested before launch. Book a free meeting."
  jsonLd={graph}
  preloadImage="/Assets/rohit-madeshiya-shopify-expert-hero.webp"
>
  <header class="hero" id="top">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="status reveal"><i class="live" aria-hidden="true"></i>Available for remote projects worldwide<i class="sep" aria-hidden="true"></i><time id="local-time"></time></p>
        <p class="hello reveal" id="hello" style="--rd:.05s">{P.greeting}</p>
        <h1 id="name" class="reveal" style="--rd:.1s">Rohit <span class="last">Madeshiya<span class="hl">.</span></span><span class="sr-only">, Shopify Expert, Developer &amp; Consultant</span></h1>
        <p class="role-line reveal" style="--rd:.15s" aria-live="polite"><span class="ri" id="role-ico" aria-hidden="true" set:html={ROLE_ICONS[P.roles[0].icon]} /><span class="rot serif" id="roles">{P.roles.map((r, i) => <span class:list={{ on: i === 0 }} data-icon={r.icon}>{r.label}</span>)}</span></p>
        <p class="tagline reveal" id="tagline" style="--rd:.2s" set:html={P.tagline} />
        <div class="hero-cta reveal" style="--rd:.25s">
          <a class="btn btn-accent" id="cta" href={P.bookingUrl} target="_blank" rel="noopener">
            <svg class="meet-ico" viewBox="0 0 87.5 72" aria-hidden="true">
              <path fill="#00832d" d="M49.5 36l8.53 9.75 11.47 7.33 2-17.02-2-16.64-11.69 6.44z"/>
              <path fill="#0066da" d="M0 51.5V66c0 3.315 2.685 6 6 6h14.5l3-10.96-3-9.54-9.95-3z"/>
              <path fill="#e94235" d="M20.5 0L0 20.5l10.55 3 9.95-3 2.95-9.41z"/>
              <path fill="#2684fc" d="M20.5 20.5H0v31h20.5z"/>
              <path fill="#00ac47" d="M82.6 8.68L69.5 19.42v33.66l13.16 10.79c1.97 1.54 4.85.135 4.85-2.37V11c0-2.535-2.945-3.925-4.91-2.32zM49.5 36v15.5h-29V72h43c3.315 0 6-2.685 6-6V53.08z"/>
              <path fill="#ffba00" d="M63.5 0h-43v20.5h29V36l20-16.57V6c0-3.315-2.685-6-6-6z"/>
            </svg>
            Book a Free Meeting
          </a>
          <a class="btn btn-ghost" href="#services">See Services <span class="arr" aria-hidden="true">→</span></a>
        </div>
        <ul class="trust reveal" style="--rd:.3s; list-style:none; padding:0" aria-label="Why work with me">
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Free first meeting</span></li>
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Clients worldwide</span></li>
          <li><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Tested before launch</span></li>
        </ul>
        <a class="scroll-cue" href="#services"><i aria-hidden="true"></i>Scroll to explore</a>
      </div>

      <figure class="portrait reveal" style="--rd:.2s; margin:0">
        <span class="ring" aria-hidden="true"></span>
        <div class="portrait-frame">
          <img src="/Assets/rohit-madeshiya-shopify-expert-hero.webp" alt="Rohit Madeshiya, Shopify expert and developer, smiling with arms crossed" width="900" height="1125" fetchpriority="high">
        </div>
        <div class="float f1" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span><span>Shopify Expert<small>Stores that sell</small></span></div>
        <div class="float f2" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><span>QA Passed<small>Every device</small></span></div>
        <div class="float f3" aria-hidden="true"><span class="fi"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg></span><span>Fast &amp; tested<small>Speed optimized</small></span></div>
      </figure>
    </div>
  </header>

  <div class="ticker" aria-hidden="true"><div class="ticker-track" id="ticker">{[...P.toolTags, ...P.toolTags].map(t => <span>{t}</span>)}</div></div>

  <!-- 01 · Services & pricing -->
  <section class="sec" id="services">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow"><b>01</b>Pricing</span><h2>Ways to Work <span class="serif">Together</span></h2><p>Clear prices, no surprises. Pick what your store needs today.</p></div>
      <div class="services" id="services-list">
        {P.services.map((s, i) => (
          <div class:list={["svc spot reveal", { featured: s.featured }]} style={`--rd:${i * 0.08}s`}>
            {s.featured && <span class="badge">★ Most Popular</span>}
            <span class="ico" set:html={SVC_ICONS[s.ico] || ""} />
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <div class="price"><small>From</small><b>{s.price}</b></div>
            {(s.delivery || s.revisions) && <div class="svc-meta">
              {s.delivery && <span><Fragment set:html={ICON_CLOCK} />Delivery in {s.delivery}</span>}
              {s.revisions && <span><Fragment set:html={ICON_LOOP} />{s.revisions}</span>}
            </div>}
            <ul>{(s.features || []).map(f => <li><Fragment set:html={TICK} />{f}</li>)}</ul>
            <a class:list={["btn", s.featured ? "btn-accent" : "btn-ghost"]} href={P.bookingUrl} target="_blank" rel="noopener" aria-label={`Get started with ${s.title}`}>Get Started <i aria-hidden="true">→</i></a>
          </div>
        ))}
      </div>
      <div class="next-steps reveal">
        <h3>What happens next</h3>
        <ol>{P.nextSteps.map((st, i) => <li><b class="ns-num">{i + 1}</b><div><b>{st.title}</b><p>{st.text}</p></div></li>)}</ol>
      </div>
      <p class="svc-note reveal">Not sure which one fits? <a href={P.bookingUrl} id="svc-call" target="_blank" rel="noopener">Book a free call</a> and we'll figure it out together. <span class="reply"><i class="live" aria-hidden="true"></i>{P.responseTime}</span></p>
      <div class="pay reveal" id="pay"><span class="pay-label">Accepted payment methods</span>{P.payments.map(p => <span class="pay-item"><Fragment set:html={PAY_ICONS[p] || ""} />{p}</span>)}</div>
    </div>
  </section>

  <!-- 02 · How I work -->
  <section class="sec alt" id="process">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow"><b>02</b>Process</span><h2>How I <span class="serif">Work</span></h2><p>No guesswork. No ghosting. Just a clear path from your idea to a store that sells.</p></div>
      <div class="process" id="process-list">
        {P.steps.map((s, i) => (
          <div class="pcard spot reveal" style={`--rd:${i * 0.08}s`}>
            <div class="num"><b>{pad(i + 1)}</b><i aria-hidden="true"></i></div>
            <h3>{s.title}</h3><p>{s.text}</p>
            <span class="big" aria-hidden="true">{pad(i + 1)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
  <section class="sec" id="projects">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow"><b>✦</b>Work</span><h2>Recent <span class="serif">Projects</span></h2><p>Real stores. Real brands. Built to look good and sell even better.</p></div>
      <div class="card-grid">{projects.slice(0, 3).map(p => <ProjectCard project={p} />)}</div>
      {projects.length > 3 && <div class="sec-foot"><a class="btn btn-ghost" href="/projects/">View all projects <span class="arr" aria-hidden="true">→</span></a></div>}
    </div>
  </section>)}

  <!-- 03 · Experience: every role is rendered; home.js switches between them -->
  <section class="sec" id="experience">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow"><b>03</b>Experience</span><h2>Career <span class="serif">Experience</span></h2><p>Built websites. Tested banking apps. Now building Shopify stores that just work.</p></div>
      <div class="exp-wrap reveal" id="exp">
        <div class="exp-tabs" role="tablist" aria-label="Roles" aria-orientation="vertical">
          {P.experience.map((e, i) => (
            <button class="exp-tab" role="tab" id={`exp-tab-${i}`} aria-controls={`exp-panel-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-short={e.short || e.org} data-full={e.title}>
              <i class="org-ico" style={`background:${e.color}`} aria-hidden="true">{e.org[0]}</i><b class="exp-full">{e.title}</b>
              <small>{e.current && <><i class="dot" aria-hidden="true"></i>Now · </>}{e.org}{e.years && ` · ${e.years}`}</small>
              <span class="chev" set:html={CHEV} />
            </button>
          ))}
        </div>
        {P.experience.map((e, i) => (
          <article class="exp-panel spot" id={`exp-panel-${i}`} role="tabpanel" aria-labelledby={`exp-tab-${i}`} style={`--org:${e.color}`} hidden={i !== 0}>
            <div class="exp-head"><i class="org-ico" style={`background:${e.color}`} aria-hidden="true">{e.org[0]}</i><span class="exp-org">{e.org}</span>
              <div class="meta">{e.current && <span class="now">Now</span>}<span>{e.place}</span>{e.years && <span>{e.years}</span>}</div>
            </div>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
            <ul class="checks">{e.checks.map(c => <li><Fragment set:html={CHECK} /><span>{c}</span></li>)}</ul>
            <div class="tags">{e.tags.map(t => <span>{t}</span>)}</div>
            <span class="count" aria-hidden="true">{pad(i + 1)} / {pad(P.experience.length)}</span>
          </article>
        ))}
      </div>
      <div class="exp-more reveal"><button class="btn btn-ghost btn-sm" type="button" data-open-resume><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>View full resume</button></div>
    </div>
    <div class="wrap">
      <!-- Photo strip and the line under it are hidden for now: remove "hidden" on both to bring them back -->
      <div class="strip" id="strip" hidden><div class="strip-track" id="strip-track">
        {[...P.workPhotos, ...P.workPhotos].map((p, i) => i < P.workPhotos.length
          ? <img src={p.src} alt={p.alt} width="900" height="675" loading="lazy" decoding="async" class="zoomable" data-group="work" tabindex="0" role="button" aria-label={`View larger: ${p.alt}`}>
          : <img src={p.src} alt={p.alt} width="900" height="675" loading="lazy" decoding="async" class="zoomable" data-group="work-copy" tabindex="-1" aria-hidden="true">)}
      </div></div>
      <p class="strip-note reveal" hidden>You see the launch. I sweat the details: <b>every page tested, every click checked</b>, so your customers only see a store that works.</p>
    </div>
  </section>

  <!-- 04 · Tools -->
  <section class="sec alt" id="tools">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow"><b>04</b>Toolkit</span><h2>Tools &amp; <span class="serif">Capabilities</span></h2><p>Modern tools, proven skills and one goal: a store that sells more.</p></div>
      <div class="bento">
        <div class="b-tools spot reveal"><h3>Tools I use every day</h3><p class="sub">From building the store to researching what works.</p>
          <div class="tool-grid" id="tools-top">{P.tools.map(t => <span class="tool"><i style={`background:${t.c}${t.c === "#f7df1e" ? ";color:#111" : ""}`} aria-hidden="true">{shortTool(t.n)}</i>{t.n}</span>)}</div>
          <p class="tool-note"><span class="live" aria-hidden="true"></span>Always exploring new AI tools to build faster and smarter.</p></div>
        <div class="b-skills spot reveal" style="--rd:.08s"><h3>What I can do for you</h3><p class="sub">Development, testing and consulting under one roof.</p><div class="skill-cloud" id="tools-bottom">{P.toolTags.map(t => <span>{t}</span>)}</div></div>
        <div class="b-quote spot reveal" style="--rd:.12s"><p>A developer who tests like a QA engineer, so <span class="serif hl">nothing breaks</span> on launch day.</p><a class="btn btn-ink" href="#services">View Services <span class="arr" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  {posts.length > 0 && (
  <section class="sec" id="blog">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow"><b>✦</b>Blog</span><h2>Latest <span class="serif">Articles</span></h2><p>Practical Shopify tips on speed, design and selling more.</p></div>
      <div class="card-grid">{posts.slice(0, 3).map(p => <PostCard post={p} />)}</div>
      <div class="sec-foot"><a class="btn btn-ghost" href="/blog/">Read the blog <span class="arr" aria-hidden="true">→</span></a></div>
    </div>
  </section>)}

  <!-- 05 · Education: every milestone is rendered; home.js switches between them -->
  <section class="sec" id="education">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow"><b>05</b>Education</span><h2>Academic <span class="serif">Journey</span></h2><p>Three milestones that taught me how to learn, think and build.</p></div>
      <div class="edu reveal" id="edu">
        <div class="edu-rail" role="tablist" aria-label="Academic milestones">
          <div class="edu-track" aria-hidden="true"><i class="edu-fill"></i></div>
          {P.education.map((e, i) => (
            <button class:list={["edu-node", { done: i < P.education.length - 1 }]} role="tab" id={`edu-tab-${i}`} aria-controls={`edu-panel-${i}`} aria-selected={i === P.education.length - 1 ? "true" : "false"} tabindex={i === P.education.length - 1 ? 0 : -1}>
              <span class="edu-pin" set:html={EDU_ICONS[e.ico] || EDU_ICONS.cap} /><b>{e.when}</b><small>{e.short}</small>
            </button>
          ))}
        </div>
        {P.education.map((e, i) => (
          <div class="edu-panel spot" id={`edu-panel-${i}`} role="tabpanel" aria-labelledby={`edu-tab-${i}`} hidden={i !== P.education.length - 1}>
            <div class="edu-big" aria-hidden="true">{e.when}<small>{e.year}</small></div>
            <div class="edu-body">
              <em class="stage">{e.stage}</em>
              <h3>{e.school}</h3>
              <p class="edu-deg">{e.degree}</p>
              {e.story && <p class="edu-story">{e.story}</p>}
              {(e.learned || []).length > 0 && <ul class="tags" aria-label="What I took away">{e.learned.map(t => <li>{t}</li>)}</ul>}
            </div>
            <span class="count" aria-hidden="true">{pad(i + 1)} / {pad(P.education.length)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 · Beyond the work -->
  <section class="sec alt" id="beyond">
    <div class="wrap">
      <div class="sec-head reveal"><span class="eyebrow"><b>06</b>Personal</span><h2>Beyond the <span class="serif">Work</span></h2><p>What keeps me curious, calm and creative once the laptop closes.</p></div>
      <div class="beyond" id="beyond-list">
        {P.beyond.map((b, bi) => (
          <div class="bcard reveal">
            <div class="btext"><span class="kicker">{bi === 0 ? "Off the clock" : "These days"}</span><h3>{b.title}</h3><p>{b.text}</p><ul>{b.items.map(it => <li>{it}</li>)}</ul></div>
            <div class:list={["mosaic", { m6: b.photos.length >= 6 }]}>
              {b.photos.map(p => p.src
                ? <figure class="tile" style="margin:0"><img src={p.src} alt={p.alt} width="900" height="675" loading="lazy" decoding="async" class="zoomable" data-group="beyond" tabindex="0" role="button" aria-label={`View larger: ${p.alt}`}><figcaption>{p.alt}</figcaption></figure>
                : <div class="tile" style={`background:${p.c}`} aria-hidden="true"></div>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 07 · FAQ -->
  <section class="sec" id="faq">
    <div class="wrap">
      <div class="sec-head center reveal"><span class="eyebrow"><b>07</b>FAQ</span><h2>Questions, <span class="serif">answered</span></h2><p>The things clients usually ask before we start.</p></div>
      <div class="faq" id="faq-list">
        {P.faq.map((f, i) => (
          <details class="reveal" style={`--rd:${i * 0.05}s`} open={i === 0}>
            <summary>{f.q}<i aria-hidden="true"></i></summary>
            <p class="ans">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <div class="words" aria-hidden="true"><div class="words-track" id="marquee">{[...P.marquee, ...P.marquee].map(w => <span>{w}</span>)}</div></div>

  <Fragment slot="after">
<div class="resume-view" id="resume-view" role="dialog" aria-modal="true" aria-labelledby="rv-name" hidden>
  <div class="rv-bar">
    <div class="rv-title"><span class="rv-dot" aria-hidden="true"></span><b id="rv-name">{P.name}</b><span>· Resume</span></div>
    <div class="rv-actions">
      <button class="btn btn-ink btn-sm" id="rv-download" type="button">↓ <span class="rv-dl-text">Download PDF</span></button>
      <button class="close" id="rv-close" type="button" aria-label="Close resume">✕</button>
    </div>
  </div>
  <div class="paper-wrap"><article class="paper" id="paper">
    <header class="r-head">
      <div><p class="r-name">{P.name}</p><p class="r-role">{P.resume.headline}</p></div>
      <div class="r-contact">
        <div><i>✉</i>{P.email}</div>
        <div><i>⌖</i>{P.resume.location}</div>
      </div>
    </header>
    <section class="r-sec"><h2>Professional Summary</h2><p>{P.resume.summary}</p></section>
    <section class="r-sec"><h2>Professional Experience</h2>
      {P.resume.jobs.map(j => <div class="r-item"><div class="r-top"><h3>{j.title}</h3><span class="r-when">{j.when}</span></div><div class="r-org">{j.org}</div><ul>{j.bullets.map(b => <li>{b}</li>)}</ul></div>)}
    </section>
    <section class="r-sec"><h2>Core Skills</h2>
      <div class="r-skills">{P.resume.skills.map(k => <div><b>{k.title}</b><span>{k.text}</span></div>)}</div>
    </section>
    <section class="r-sec"><h2>Tools</h2>
      <div class="r-tools">{P.resume.tools.map(t => <div><b>{t.group}:</b> {t.list}</div>)}</div>
    </section>
    <section class="r-sec"><h2>Education</h2>
      <div class="r-rows">{P.education.map(e => <div class="r-row"><span><b>{e.school}</b> · {e.degree}</span><span>{e.year}</span></div>)}</div>
    </section>
    <section class="r-sec"><h2>Awards &amp; Recognition</h2>
      <div class="r-rows">{P.resume.honors.map(h => <div class="r-row"><span><b>{h.name}</b> · {h.detail}</span><span>{h.year}</span></div>)}</div>
    </section>
    <section class="r-sec"><h2>Languages</h2>
      <div class="r-langs">{P.resume.languages.map(l => <span><b>{l.name}</b> · {l.level}</span>)}</div>
    </section>
  </article></div>
</div>

<script is:inline define:vars={{ HOME: { name: P.name, roleIcons: Object.fromEntries(P.roles.map(r => [r.icon, ROLE_ICONS[r.icon]])), timeZone: P.timeZone, resumePdf: P.resumePdf } }}>
  window.HOME = HOME;
</script>
<script is:inline src="/js/home.js"></script>
  </Fragment>
</Base>
