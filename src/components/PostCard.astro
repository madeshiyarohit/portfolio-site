---
import { readingTime, formatDate } from "../lib/content.js";
const { post, wide = false, headingLevel = "h3" } = Astro.props;
const d = post.data;
const H = headingLevel;
---
<a class:list={["bcard2 spot reveal", { wide }]} href={`/blog/${post.id}/`} target="_blank" rel="noopener" data-tags={d.tags.join("|")}>
  {d.draft && <span class="draft-badge">Draft</span>}
  <div class="thumb">
    {d.cover
      ? <img src={d.cover} alt={d.coverAlt || d.title} width="1200" height="750" loading="lazy" decoding="async">
      : <span class="ph" aria-hidden="true">{d.title.split(" ").slice(0, 3).join(" ")}…</span>}
  </div>
  <div class="card-body">
    {d.tags[0] && <span class="card-kicker">{d.tags[0]}</span>}
    <H>{d.title}</H>
    <p>{d.description}</p>
    <div class="card-meta"><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time><span>·</span><span>{readingTime(post.body)} min read</span></div>
  </div>
  <span class="card-go" aria-hidden="true">→</span>
  <span class="sr-only">(opens in a new tab)</span>
</a>
