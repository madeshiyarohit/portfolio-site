---
const { project, headingLevel = "h3" } = Astro.props;
const d = project.data;
const H = headingLevel;
---
<a class="pcard2 spot reveal" href={`/projects/${project.id}/`} target="_blank" rel="noopener">
  {d.draft && <span class="draft-badge">Draft</span>}
  {d.reference && <span class="ref-badge">Reference study</span>}
  <div class="thumb">
    <img src={d.cover} alt={d.coverAlt || `${d.title}, a Shopify project for ${d.client}`} width="1200" height="750" loading="lazy" decoding="async">
  </div>
  <div class="card-body">
    <span class="card-kicker">{d.industry || d.client}</span>
    <H>{d.title}</H>
    <p>{d.summary}</p>
    {d.services.length > 0 && <div class="chips">{d.services.slice(0, 3).map(s => <span>{s}</span>)}</div>}
  </div>
  <span class="card-go" aria-hidden="true">→</span>
  <span class="sr-only">(opens in a new tab)</span>
</a>
